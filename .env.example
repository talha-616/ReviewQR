# Google Maps Platform (browser-restricted key)
# Enable: Maps JavaScript API, Places API (New)
# Restrict this key to your production domains (HTTP referrers).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional. Cloud-based map style ID. Falls back to DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Canonical site URL for SEO (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Reserved. Keep false until you add ads.
NEXT_PUBLIC_ADS_ENABLED=false
